{
  "name": "@kevincharm/gfc-fpe",
  "version": "2.0.0",
  "description": "A stateless Thorp shuffle equivalent to solshuffle's Solidity and Yul implementations.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm check:format && pnpm check:types",
    "check:format": "prettier --check .",
    "check:types": "tsc --noEmit",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "test": "pnpm test:unit && pnpm test:pack",
    "test:pack": "node --test test/package.test.ts",
    "test:unit": "node --test test/index.test.ts",
    "verify": "pnpm check && pnpm test && npm pack --dry-run",
    "prepack": "pnpm clean && pnpm build"
  },
  "keywords": [
    "shuffle",
    "thorp",
    "permutation",
    "format-preserving",
    "ethereum",
    "solidity"
  ],
  "author": "Kevin Charm <kevin@kevincharm.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevincharm/gfc-fpe.git"
  },
  "bugs": {
    "url": "https://github.com/kevincharm/gfc-fpe/issues"
  },
  "license": "WTFPL",
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
